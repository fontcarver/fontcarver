{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Font Cutter",
  "version": "0.1.0",
  "identifier": "com.fontcutter.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../app build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Font Cutter",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
