# Cloudflare Pages response headers.
#
# The content security policy is what keeps the promise the site makes: every
# byte it loads comes from its own origin. There is no third-party script, no
# font CDN, no analytics, and no inline script or style to relax the policy
# for — which is also why the site works from anywhere.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's own output: every file name carries a content hash.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
