{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Archived review ledgers are records, not code.
  "ignore": ["docs/archive/**"],
  // CI runs these from the app package (`pnpm --dir app exec …`).
  "ignoreBinaries": ["prettier", "vitest"],
  "workspaces": {
    // Phase acceptance suites, run with `playwright test --config e2e/<phase>.config.ts`.
    "app": { "entry": ["e2e/*.config.ts", "e2e/*.vite.config.ts"] }
  },
  // Unused exports are reported but do not fail the run.
  "rules": { "exports": "warn", "types": "warn", "duplicates": "warn" }
}
